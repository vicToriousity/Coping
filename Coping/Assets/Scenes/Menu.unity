      m_Calls: []
  m_text: '-=Keywords=-

    -Fissures-

    Four rankings: Minor, normal, Major
    and Final.

    -Mastery Rank-

    Your expertise with your Power. F, E, D,
    C, B, A, S, Noble.

    -Sectors-

    The areas parted by dividers, holding
    your fellow Wielders, the Fissures and the Central Sector.

    -Artifacts-

    Rare
    items or weapons that may have special effects.'
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 4c08cdd3096ca9d4e9c1804e2b1393f7, type: 2}
